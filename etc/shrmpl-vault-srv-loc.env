# Vault Server Configuration
VAULT_BIND_ADDR=0.0.0.0:7474
VAULT_SERVER_NAME=shrmpl-vault-loc

# TLS configuration
VAULT_TLS_PRIVKEY_PATH=/Users/brandon/Code/shrmpl-srv-preview/etc/crt/shrmpl_vault_server_privkey.pem
VAULT_TLS_FULLCHAIN_PATH=/Users/brandon/Code/shrmpl-srv-preview/etc/crt/shrmpl_vault_server_fullchain.pem

# mTLS configuration
VAULT_MTLS_CA_CERT_PATH=/Users/brandon/Code/shrmpl-srv-preview/etc/crt/shrmpl_vault_mtls_ca.pem

# File storage
VAULT_CONFIG_DIR=/Users/brandon/Code/shrmpl-srv-preview/etc/vault-configs

# Security
VAULT_ALLOWED_SECRETS=dev-secret-key,prod-secret-key,test-secret-key
VAULT_RATE_LIMIT_PER_MIN=60

# --- Logging (shrmpl-log) ---
SLOG_DEST=127.0.0.1:7379
SLOG_LEVEL=DEBUG
SLOG_CONSOLE=false
SLOG_SEND_ACTV=true
SLOG_SEND_LOG=true
