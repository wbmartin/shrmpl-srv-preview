# Example endpoint config for shrmpl-pulsecheck

# URL to check (GET request)
PULSE_URL=https://example.com

# Check interval in seconds (minimum 5)
PULSE_INTERVAL_SEC=60

# Expected HTTP status code (default 200)
PULSE_EXPECT_STATUS=200

# Minutes between escalation alerts (minimum 1)
PULSE_ESCALATION_MIN=30

# Slack webhook for alerts (optional)
# PULSE_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../xxx

# Appended to all Slack messages, e.g. user mention (optional)
# PULSE_SLACK_MESSAGE=<@U05U7ENTJ1W>
