# --- Network ---
NACK_LISTEN_ADDR=127.0.0.1
NACK_LISTEN_PORT=7575

# --- Paths ---
NACK_MONITORS_DIR=/Users/brandon/Code/shrmpl-srv-preview/etc/nack-monitors

# --- Status Endpoint (use a GUID to obscure) ---
NACK_STATUS_PATH=/status/b7e3f1a2-9c4d-4e8b-a1f0-2d3c4b5a6e7f

# --- Escalation Defaults ---
NACK_ESCALATION_MISSES=3
NACK_ESCALATION_INTERVAL_MIN=60

# --- Logging (shrmpl-log) ---
SLOG_DEST=127.0.0.1:7379
SLOG_LEVEL=DEBUG
SLOG_CONSOLE=true
SLOG_SEND_ACTV=true
SLOG_SEND_LOG=false
