CICD_SERVER_NAME=local-dev-cicd
# --- Network ---
CICD_TLS_MODE=plain
CICD_LISTEN_ADDR=127.0.0.1
CICD_LISTEN_PORT=8080

# --- Paths ---
CICD_HOOKS_DIR=/Users/brandon/Code/shrmpl-srv-preview/etc/cicd-hooks

# --- Limits ---
CICD_MAX_CONCURRENT=4
CICD_DEFAULT_TIMEOUT=300

# --- Logging (shrmpl-log) ---
SLOG_DEST=127.0.0.1:7379
SLOG_LEVEL=DEBUG
SLOG_CONSOLE=true
SLOG_SEND_ACTV=true
SLOG_SEND_LOG=false
