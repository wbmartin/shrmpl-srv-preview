# shrmpl-pulsecheck-srv local dev config

# Network
PULSE_LISTEN_ADDR=127.0.0.1
PULSE_LISTEN_PORT=7576

# Endpoints directory
PULSE_ENDPOINTS_DIR=/Users/brandon/Code/shrmpl-srv-preview/etc/pulse-endpoints

# Status endpoint (use a GUID to obscure)
PULSE_STATUS_PATH=/status/a3b2c1d0-e4f5-6789-abcd-ef0123456789

# Server name (appears in Slack messages)
PULSE_SERVER_NAME=shrmpl-pulsecheck-dev

# Admin Slack webhook for startup errors (optional)
# PULSE_ADMIN_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../xxx

# Logging
SLOG_DEST=127.0.0.1:7379
SLOG_LEVEL=DEBUG
SLOG_CONSOLE=true
SLOG_SEND_ACTV=true
SLOG_SEND_LOG=false
